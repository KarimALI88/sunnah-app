{
  "expo": {
    "name": "سكينة",
    "slug": "sakinah",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sakinah",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f2fbff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يُستخدم الموقع لتحديد اتجاه القبلة ومواقيت الصلاة حسب مدينتك.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "يُستخدم الموقع لتحديد اتجاه القبلة ومواقيت الصلاة حسب مدينتك.",
        "NSMotionUsageDescription": "يُستخدم مستشعر الاتجاه لعرض بوصلة القبلة."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#024356"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يُستخدم الموقع لتحديد اتجاه القبلة ومواقيت الصلاة حسب مدينتك."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
